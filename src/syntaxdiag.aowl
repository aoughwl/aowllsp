## syntaxdiag.aowl — recovering *syntax* diagnostics for the LIVE buffer, from
## aowlsuggest (which drives aowlparser). `aowlmony check` aborts on the first
## syntax error and only sees the on-disk file; aowlsuggest recovers past every
## error and reads the unsaved buffer over stdin — so this fills the gap between
## keystrokes. Off when aowlsuggest isn't configured.

import protocol, state, diagnostics
import util

proc severityFrom(s: string): DiagnosticSeverity =
  case s
  of "error": dsError
  of "warning": dsWarning
  of "hint": dsHint
  else: dsError

proc parseOne(el: JsonValue; file: string; d: var FileDiag): bool =
  ## Decode one aowlsuggest diagnostic object (line 1-based, col/endCol 0-based).
  if el{"line"} == nil: return false
  let sev = severityFrom(getStr(el{"severity"}))
  let code = getStr(el{"code"})
  let msg = getStr(el{"message"})
  let line = jInt(el{"line"})
  let col = jInt(el{"col"})
  let endCol = jInt(el{"endCol"})
  let l = if line > 0: line - 1 else: 0
  var ec = endCol
  if ec <= col: ec = col + 1
  # The rule id goes in LSP's `code` field (so editors can show/filter by it and
  # offer a rule link), NOT smuggled into the message text.
  let href = if code.len > 0:
    "https://github.com/aoughwl/aowlsuggest#fix" else: ""
  d = FileDiag(file: file, diag: Diagnostic(
    rng: mkRange(l, col, l, ec), severity: sev, source: "aowlsuggest",
    message: msg, code: code, codeHref: href, related: @[]))
  return true

proc syntaxDiagnostics*(cfg: Config; file, bufferText: string): seq[FileDiag] =
  ## Run `aowlsuggest check --stdin --filename:<file> --format:json` over the
  ## buffer and decode its diagnostics. Empty when aowlsuggest is unavailable.
  result = @[]
  if cfg.aowlsuggestExe.len == 0: return
  var args = @["check", "--stdin", "--filename:" & file, "--format:json"]
  for f in cfg.styleFlags: args.add f   # opt-in style diagnostics, live
  let cap = runWithInput(cfg.aowlsuggestExe, args, bufferText)
  if not cap.ok or cap.output.len == 0: return
  let arr = parseJsonOrNull(cap.output)
  if kindOf(arr) != jnArray: return
  for el in items(arr):
    if kindOf(el) != jnObject: continue
    var d = default(FileDiag)
    if parseOne(el, file, d):
      result.add d
