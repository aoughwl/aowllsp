## uris.aowl -- file:// URI <-> filesystem path, with minimal percent-coding.
##
## Internal paths are always `/`-separated; a Windows path keeps its drive
## letter, upper-cased (`C:/Users/x/a.aowl`). Editors send the same file as
## `file:///c%3A/Users/x/a.aowl` or `file:///C:/Users/x/a.aowl`; `normUri` maps
## both to one canonical URI so open buffers are found regardless of spelling.

proc hexVal(c: char): int =
  if c >= '0' and c <= '9': ord(c) - ord('0')
  elif c >= 'a' and c <= 'f': ord(c) - ord('a') + 10
  elif c >= 'A' and c <= 'F': ord(c) - ord('A') + 10
  else: -1

proc percentDecode(s: string): string =
  result = ""
  var i = 0
  while i < s.len:
    if s[i] == '%' and i + 2 < s.len:
      let h = hexVal(s[i+1])
      let l = hexVal(s[i+2])
      if h >= 0 and l >= 0:
        result.add chr(h * 16 + l)
        i += 3
        continue
    result.add s[i]
    inc i

proc isDriveLetter(c: char): bool =
  (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')

proc hasDrive*(p: string): bool =
  ## `C:` / `C:/...` / `C:\...`
  p.len >= 2 and isDriveLetter(p[0]) and p[1] == ':'

proc isAbsPath*(p: string): bool =
  ## Absolute on either platform form: leading `/` or `\`, or a drive prefix.
  (p.len > 0 and (p[0] == '/' or p[0] == '\\')) or hasDrive(p)

proc normPath*(p: string): string =
  ## `/`-separated, drive letter upper-cased, no trailing slash (except a root).
  result = p
  for i in 0 ..< result.len:
    if result[i] == '\\': result[i] = '/'
  if hasDrive(result) and result[0] >= 'a' and result[0] <= 'z':
    result[0] = chr(ord(result[0]) - 32)
  while result.len > 3 and result[result.len - 1] == '/':
    result.setLen(result.len - 1)

proc uriToPath*(uri: string): string =
  ## `file:///C:/x%20y.aowl` -> `C:/x y.aowl`. Non-file URIs pass through.
  var s = uri
  if s.len >= 7 and substr(s, 0, 6) == "file://":
    s = substr(s, 7, s.len - 1)
  s = percentDecode(s)
  # `/C:/dir` -> `C:/dir`
  if s.len >= 3 and s[0] == '/' and hasDrive(substr(s, 1, s.len - 1)): s = substr(s, 1, s.len - 1)
  result = normPath(s)

proc percentEncodePath(s: string): string =
  ## Encode a path for a file URI: keep '/', ':' and unreserved chars;
  ## percent-encode the rest (spaces etc.).
  const hexd = "0123456789ABCDEF"
  result = ""
  for i in 0 ..< s.len:
    let c = s[i]
    if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or
       (c >= '0' and c <= '9') or c == '/' or c == '-' or c == '_' or
       c == '.' or c == '~' or c == ':':
      result.add c
    else:
      result.add '%'
      result.add hexd[(ord(c) shr 4) and 0xF]
      result.add hexd[ord(c) and 0xF]

proc pathToUri*(path: string): string =
  ## `C:/x y.aowl` -> `file:///C:/x%20y.aowl`; `/x` -> `file:///x`.
  var p = normPath(path)
  if p.len == 0 or p[0] != '/': p = "/" & p
  result = "file://" & percentEncodePath(p)

proc normUri*(uri: string): string =
  ## The canonical spelling of a `file://` URI; anything else is returned as is.
  if uri.len >= 7 and substr(uri, 0, 6) == "file://": pathToUri(uriToPath(uri))
  else: uri
